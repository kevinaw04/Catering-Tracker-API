  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023"], "types": ["node"],
    "module": "ESNext", "moduleResolution": "bundler", "strict": true,
    "skipLibCheck": true, "noEmit": true, "verbatimModuleSyntax": true,
    "tsBuildInfoFile": "./node_modules/.tmp/node.tsbuildinfo"
